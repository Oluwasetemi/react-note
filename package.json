{
  "name": "react-note",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_OPTIONS='--openssl-legacy-provider --max_old_space_size=8192 --max-http-header-size=16384 --no-warnings' PLAYWRIGHT_TIMEOUT=300000 SLIDEV_TIMEOUT=300000 slidev build --base=/",
    "build:pdf": "cross-env NODE_OPTIONS='--openssl-legacy-provider --max_old_space_size=8192 --max-http-header-size=16384 --no-warnings' PLAYWRIGHT_TIMEOUT=300000 SLIDEV_TIMEOUT=300000 slidev export --timeout 300000",
    "debug": "nodemon -w '../../packages/slidev/dist/*.mjs' --exec \"slidev ./slides.md --open=false --log=info --inspect\"",
    "dev": "slidev ./slides.md --open=false --log=info",
    "export": "slidev export",
    "export:pdf": "npm run export -- --timeout 160000 --output ./_export/react-note.pdf",
    "export:pptx": "npm run export -- --timeout 160000 --with-clicks false --format pptx --output ./_export/react-note.pptx",
    "format": "prettier --write .",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/client": "53.0.0",
    "@slidev/theme-default": "latest",
    "@vueuse/core": "^15.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@babel/standalone": "^8.0.7",
    "@iconify-json/logos": "^1.2.16",
    "@iconify-json/mdi": "^1.2.3",
    "@slidev/types": "53.0.0",
    "@types/babel__standalone": "^7.1.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vue/compiler-sfc": "^3.5.44",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.3",
    "markdown-it-magic-link": "^0.1.4",
    "nano-staged": "^1.0.2",
    "nodemon": "^3.1.14",
    "playwright-chromium": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-slidev": "^1.0.5",
    "shiki": "^4.5.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "unocss": "66.11.0",
    "vite": "^8.3.4"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.11.2"
}
